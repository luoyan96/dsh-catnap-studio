{
  "name": "dsh-client-ui-skin-catnap",
  "description": "Catnap Studio skin pack for the DeepSeek Harness web UI with three selectable cat themes: Warm Paper, Moonlit Guardian, and Cat Atelier",
  "version": "0.2.0",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "skin",
    "theme",
    "cat"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "license": "BSD-3-Clause",
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "packageManager": "pnpm@11.21.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luoyan96/dsh-catnap-studio.git"
  },
  "homepage": "https://github.com/luoyan96/dsh-catnap-studio#readme",
  "bugs": {
    "url": "https://github.com/luoyan96/dsh-catnap-studio/issues"
  },
  "peerDependencies": {},
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^22.20.0",
    "jsdom": "29.1.1",
    "lightningcss": "^1.32.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "skin.json",
    "preview",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "assets": "node scripts/embed-cat.mjs",
    "build": "pnpm run assets && tsdown",
    "prepare": "pnpm run build",
    "pretypecheck": "pnpm run assets",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm run assets",
    "test": "vitest run",
    "pack:check": "pnpm pack --dry-run",
    "ci": "pnpm run typecheck && pnpm test && pnpm run build && pnpm run pack:check"
  }
}
